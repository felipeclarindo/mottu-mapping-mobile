{
  "expo": {
    "name": "MottuMapping",
    "slug": "mottu-mapping-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/favicon.png",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mottu.mapping.app"
    },
    "android": {
      "package": "mottu.mapping.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "expo-notifications",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "c6ff7051-505b-4da6-878a-289457255b0e"
      }
    },
    "owner": "andremarko"
  }
}
